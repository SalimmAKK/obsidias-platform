# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Never commit .env.local — it's already
# gitignored via the `.env*` rule.

# Public — safe to expose to the browser. Used by the client-side Supabase
# client (auth session, Realtime subscriptions) and RLS scopes everything
# it can touch to the signed-in user's agency.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. Used by platform/frontend/src/app/api/v1/** route
# handlers to bypass RLS for writes. NEVER prefix this with NEXT_PUBLIC_,
# never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same Upstash Redis instance platform/worker uses (the ioredis/TCP
# connection string, not the REST URL/Token pair). This lets API routes
# enqueue jobs (e.g. lead qualification) for the worker to pick up. Optional
# for local dev — routes that would enqueue a job just skip it with a
# console warning if this isn't set.
REDIS_URL=

# WhatsApp Cloud API webhook (api/v1/webhooks/whatsapp). Both required for
# the route to accept requests at all — it refuses to process anything
# without them rather than silently skipping verification.
#
# WHATSAPP_VERIFY_TOKEN: any random string you make up yourself. Enter the
# same value in Meta's App Dashboard > WhatsApp > Configuration > Webhook
# when you register this URL — Meta echoes it back on the one-time GET
# handshake to prove you own the endpoint.
#
# META_APP_SECRET: from Meta's App Dashboard > App Settings > Basic > App
# Secret. Used to verify the X-Hub-Signature-256 header on every POST, so a
# stranger can't forge inbound "messages" and inject fake leads.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
