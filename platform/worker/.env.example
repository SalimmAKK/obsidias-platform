# Copy to .env for local dev, or set these in Railway's Variables tab for
# the deployed service. Never commit the real .env — it's gitignored.

# ── Required for Phase 1 (queue infrastructure) ────────────────────────────

# ioredis-compatible connection string from Upstash. In the Upstash
# dashboard this is the "Redis Connect" string, NOT the REST URL/Token pair
# (that's a different HTTP-based SDK BullMQ doesn't use). Looks like:
# rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# Same Supabase project as platform/frontend. This process runs unattended
# with no user session, so it always uses the service-role key (bypasses
# RLS) — never the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Added in later phases — leave blank until that phase starts ──────────
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
SENDGRID_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
CALCOM_API_KEY=
GOHIGHLEVEL_API_KEY=

# Slack "Incoming Webhook" URL (api.slack.com/apps -> your app -> Incoming
# Webhooks -> Add New Webhook to Workspace). Posts a message to whichever
# channel you pick when creating it. Optional — notifications just no-op
# with a console warning if this isn't set.
SLACK_WEBHOOK_URL=

# Deployed frontend origin, e.g. https://obsidias.vercel.app (no trailing
# slash). Used only to build a clickable "View lead" link in Slack
# notifications. Optional — notifications still send without it.
APP_BASE_URL=
